# ---- Branding / public pages (Play Console needs /privacy and /delete-account URLs)
APP_NAME=ApexHunt AI
COMPANY_NAME=ApexHunt AI
PUBLIC_BASE_URL=https://apexhunt-gateway.onrender.com
SUPPORT_EMAIL=support@yourdomain.com

# ---- Supabase (Project Settings → Database → Connection string, "Session pooler", URI)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://xxxx.supabase.co
# Legacy HS256 projects only (Project Settings → API → JWT secret). Leave empty for new asymmetric keys (JWKS is used).
SUPABASE_JWT_SECRET=
# Needed for in-app account deletion (Project Settings → API keys → secret / service_role). Never put this in the app.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Managed AI (master key — users never see the provider)
OPENROUTER_API_KEY=sk-or-v1-...
# Optional overrides: comma-separated fallbacks, first available wins
# TIER_FLASH_MODELS=deepseek/deepseek-v4-flash,deepseek/deepseek-v3.2
# TIER_PRO_MODELS=anthropic/claude-haiku-5.5,openai/gpt-6-luna
# TIER_ELITE_MODELS=anthropic/claude-sonnet-5.5
WELCOME_CREDIT_USD=0.50
MIN_BALANCE_USD=0.02
MAX_COMPLETION_TOKENS=6000
REQUIRE_SUBSCRIPTION_FOR_MANAGED=false
RATE_LIMIT_PER_MINUTE=30

# ---- RevenueCat (Project → Integrations → Webhooks: set Authorization header to exactly this value)
REVENUECAT_WEBHOOK_AUTH=Bearer change-me-long-random-string
REVENUECAT_SECRET_KEY=sk_...
REVENUECAT_ENTITLEMENT=pro
CREDIT_PACKS=apex_credits_5:5,apex_credits_10:10,apex_credits_25:25
PRO_MONTHLY_BONUS_USD=1.00
# Set to false once you leave closed testing so license-tester purchases don't mint real credits
ALLOW_SANDBOX_PURCHASES=true

# ---- Keyed job sources (optional, free tiers): developer.adzuna.com, jooble.org/api/about
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
